{
  "name": "@zaptime/react",
  "version": "1.0.0",
  "type": "module",
  "main": "dist/entry.js",
  "types": "dist/entry.d.ts",
  "exports": {
    ".": {
      "types": "./dist/entry.d.ts",
      "import": "./dist/entry.js"
    },
    "./style.css": "./dist/style.css",
    "./dist/style.css": "./dist/style.css"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "build": "vite build && tsc --declaration --emitDeclarationOnly"
  },
  "dependencies": {
    "@zaptime/core": "workspace:*",
    "@zaptime/react-headless": "workspace:*",
    "@zaptime/browser": "workspace:*"
  },
  "peerDependencies": {
    "react": "^18.3.0 || ^19.0.0"
  },
  "devDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/dom": "^10.4.1",
    "vitest": "^4.1.0",
    "happy-dom": "^20.8.4",
    "typescript": "^5.9.3",
    "tsdown": "^0.21.3",
    "@types/node": "^22.14.0",
    "vite": "^8.0.0",
    "tailwindcss": "3.4.17",
    "postcss": "^8.5.8",
    "autoprefixer": "^10.4.27",
    "@tailwindcss/forms": "^0.5.11"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  }
}
