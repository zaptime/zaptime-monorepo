{
  "name": "@zaptime/react-core",
  "description": "Headless React hooks for Zaptime calendar booking (React mirror of @zaptime/core).",
  "version": "0.0.0",
  "type": "module",
  "main": "dist/entry.mjs",
  "module": "dist/entry.mjs",
  "types": "dist/entry.d.mts",
  "author": "Zaptime s.r.o.",
  "license": "MIT",
  "exports": {
    ".": {
      "types": "./dist/entry.d.mts",
      "import": "./dist/entry.mjs",
      "default": "./dist/entry.mjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@date-fns/tz": "^1.4.1",
    "date-fns": "^4.1.0",
    "ts-results-es": "^5.0.1"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/zaptime/zaptime-monorepo"
  },
  "devDependencies": {
    "@testing-library/react": "^16.1.0",
    "@types/node": "^22.14.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@zaptime/core-shared": "workspace:*",
    "happy-dom": "^20.8.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tsdown": "^0.21.3",
    "typescript": "^5.9.3",
    "vitest": "^4.1.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
