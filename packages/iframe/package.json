{
  "name": "iframe",
  "private": true,
  "version": "0.1.1",
  "type": "module",
  "scripts": {
    "dev": "vp dev",
    "build": "vp build && vp pack && pnpm merge-files",
    "merge-files": "cat ./zoid/zoid.js ./zoid/zaptime-init.js > ./dist/zaptime.js",
    "preview": "vp preview",
    "deploy": "wrangler deploy --name iframe --compatibility-date 2026-02-17 --assets dist",
    "test": "vp test run",
    "test:watch": "vp test",
    "test:coverage": "vp test run --coverage"
  },
  "dependencies": {
    "@zaptime/core": "workspace:*",
    "@zaptime/vue3": "workspace:*",
    "vue": "^3.5.30"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/zaptime/zaptime-monorepo"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "@vitejs/plugin-vue": "^6.0.0",
    "autoprefixer": "^10.4.27",
    "happy-dom": "^20.8.4",
    "postcss": "^8.5.8",
    "tailwindcss": "^3.4.1",
    "vite-plus": "latest"
  }
}
